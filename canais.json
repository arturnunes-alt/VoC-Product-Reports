{
  "periodo": {
    "descricao": "Semana anterior completa (segunda 00:00 a domingo 23:59 BRT)",
    "timezone_databricks": "BRT — campos _br já convertidos, não somar horas",
    "timezone_zendesk": "UTC — somar 3h ao horário BRT nas queries"
  },
  "funil_suporte": {
    "descricao": "Distribuicao de volume obrigatoria em TODOS os reports (Geral, Executivo, Produtos) -- decisao de negocio da VoC, distinta do channel_class4 oficial da organizacao",
    "fonte": "prod.cx.agg_overview (via cx-product-insights) para volume; fat_help_center_events / CX-009 para Central de Ajuda",
    "camadas": [
      {
        "nome": "RecargaBot",
        "definicao": "retido, sem transbordo",
        "filtro": "flg_retention_bot = true",
        "observacao": "Independente de canal -- flag propria",
        "fonte_volume": "prod.cx.agg_overview (flg_retention_bot=true, ticket_count)",
        "fonte_retencao_pct": "prod.cx.agg_botmaker_metrics (SUM(retained_by_bot)/SUM(total_sessions), por stage se necessario)",
        "observacao_retencao": "NAO usar CX-005 de cx-product-insights nem fat_botmaker_metrics (descontinuado) -- agg_botmaker_metrics e a fonte correta, com detalhamento por stage, overflow e abandono",
        "fonte_csat_bot": "prod.cx.agg_botmaker_metrics (SUM(csat_promoter)/SUM(csat_answered))"
      },
      {
        "nome": "N1 Humano",
        "definicao": "chat online + c2c + e-mail",
        "filtro": "flg_human = true AND friendly_service_channel IN ('chat online', 'c2c', 'e-mail')",
        "observacao": "NAO inclui social media, mesmo classificado como n1 pelo channel_class4 oficial"
      },
      {
        "nome": "N2 Special Cases",
        "definicao": "special cases + ouvidoria + redes sociais + stores + canais especiais",
        "filtro": "flg_human = true AND friendly_service_channel IN ('special cases', 'ouvidoria', 'social media', 'stores', 'canais especiais')",
        "observacao": "redes sociais (friendly_service_channel='social media') entra aqui por decisao editorial da VoC, nao por channel_class4"
      }
    ],
    "central_de_ajuda": {
      "metrica": "CX-009 Visitas Unicas Vertical (cx-product-insights)",
      "filtro": "source='central' AND metric='vertical' AND product='total' AND vertical IS NOT NULL",
      "apresentar": "serie de 5 semanas, por produto em todo report de produto; agregado no Geral/Executivo"
    },
    "excluir_sempre": [
      "friendly_service_channel = 'derivacao'",
      "flg_invalid_bot = true",
      "ver lista completa em cx-orchestrator-reference/references/exclusions.md"
    ]
  },
  "indicadores": {
    "nps_transacional": {
      "meta": 75,
      "escala": "0-10",
      "promotores": ">=9",
      "detratores": "<=6",
      "metrica_indecx": "nps-0-10",
      "historico_semanas": 5,
      "fonte_oficial": "prod.cx.agg_overview (metric='nps tx')"
    },
    "nps_relacional": {
      "meta": 50,
      "escala": "0-10",
      "promotores": ">=9",
      "detratores": "<=6",
      "segmentacao": [
        "PF",
        "PJ"
      ],
      "historico_semanas": 5,
      "fonte_oficial": "prod.cx.fat_indecx_metrics (Databricks) -- confirmar metrica no schema; omitir se indisponivel"
    },
    "csat_n1": {
      "meta_pct_satisfeitos": 80,
      "escala": "1-5",
      "satisfeitos": ">=4",
      "insatisfeitos": "<=2",
      "metrica_indecx": "csat-1-5",
      "filtro_join": "flg_human = true",
      "historico_semanas": 5,
      "fonte_oficial": "prod.cx.agg_overview (metric='csat')"
    },
    "csat_bot": {
      "meta_pct_satisfeitos": 80,
      "escala": "1-5",
      "metrica_indecx": "csat-1-5",
      "filtro_join": "flg_retention_bot = true",
      "historico_semanas": 5,
      "fonte_oficial": "prod.cx.agg_overview (metric='csat', flg_retention_bot=true)"
    },
    "retencao_bot": {
      "descricao": "% contatos retidos pelo bot sem transbordo para humano",
      "calculo": "flg_retention_bot = true / total contatos bot",
      "historico_semanas": 5
    }
  },
  "perfis_cliente": {
    "new": {
      "descricao": "Conta criada ha 30 dias ou menos",
      "campo": "fat_user_data.reg_date <= CURRENT_DATE - 30"
    },
    "newnew": {
      "descricao": "Conta com mais de 30 dias sem uso do produto analisado",
      "campo": "fat_user_data.reg_date > CURRENT_DATE - 30 AND sem pedidos em clo_orders para o produto"
    },
    "repeat": {
      "descricao": "Cliente que ja utilizou o produto anteriormente",
      "campo": "tem registros em clo_orders para o produto"
    }
  },
