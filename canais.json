{
  "periodo": {
    "descricao": "Semana anterior completa (segunda 00:00 a domingo 23:59 BRT)",
    "timezone_databricks": "BRT — campos _br já convertidos, não somar horas",
    "timezone_zendesk": "UTC — somar 3h ao horário BRT nas queries"
  },
  "funil_suporte": {
    "descricao": "Separação obrigatória em todas as análises",
    "camadas": [
      {
        "nome": "Central de Ajuda",
        "fonte": "prod.cx.fat_help_center_events ou Amplitude",
        "filtro": "acessos a artigos — excluir bots e automações internas"
      },
      {
        "nome": "RecargaBot",
        "fonte": "dim_zendesk_tickets_summary",
        "filtro": "flg_retention_bot = true"
      },
      {
        "nome": "Customer Service N1",
        "fonte": "dim_zendesk_tickets_summary",
        "filtro": "flg_human = true AND flg_invalid_bot = false AND flg_retention_bot = false AND key_channel NOT LIKE '%deriva%'"
      },
      {
        "nome": "Special Cases N2",
        "fonte": "dim_zendesk_tickets_summary",
        "filtro": "key_channel REGEXP 'ouvidoria|reclameaqui|consumidor\\.gov|bacen|procon|redes.sociais'"
      }
    ],
    "excluir_sempre": [
      "flg_invalid_bot = true",
      "key_channel LIKE '%deriva%'",
      "tags: created_for_side_conversation, qa-user, spam, ticket_fundido, closed_by_merge, fluxo_automatico_sem_interacao"
    ]
  },
  "indicadores": {
    "nps_transacional": {
      "meta": 75,
      "escala": "0-10",
      "promotores": ">=9",
      "detratores": "<=6",
      "metrica_indecx": "nps-0-10",
      "historico_semanas": 5
    },
    "nps_relacional": {
      "meta": 50,
      "escala": "0-10",
      "promotores": ">=9",
      "detratores": "<=6",
      "segmentacao": ["PF", "PJ"],
      "historico_semanas": 5
    },
    "csat_n1": {
      "meta_pct_satisfeitos": 80,
      "escala": "1-5",
      "satisfeitos": ">=4",
      "insatisfeitos": "<=2",
      "metrica_indecx": "csat-1-5",
      "filtro_join": "flg_human = true",
      "historico_semanas": 5
    },
    "csat_bot": {
      "meta_pct_satisfeitos": 80,
      "escala": "1-5",
      "metrica_indecx": "csat-1-5",
      "filtro_join": "flg_retention_bot = true",
      "historico_semanas": 5
    },
    "retencao_bot": {
      "descricao": "% contatos retidos pelo bot sem transbordo para humano",
      "calculo": "flg_retention_bot = true / total contatos bot",
      "historico_semanas": 5
    }
  },
  "perfis_cliente": {
    "new": {
      "descricao": "Conta criada ha 30 dias ou menos",
      "campo": "fat_user_data.reg_date <= CURRENT_DATE - 30"
    },
    "newnew": {
      "descricao": "Conta com mais de 30 dias sem uso do produto analisado",
      "campo": "fat_user_data.reg_date > CURRENT_DATE - 30 AND sem pedidos em clo_orders para o produto"
    },
    "repeat": {
      "descricao": "Cliente que ja utilizou o produto anteriormente",
      "campo": "tem registros em clo_orders para o produto"
    }
  },
